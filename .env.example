# =============================================================================
# Marketplace Server Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# All settings are optional - defaults are provided for each.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string (required for production)
# DATABASE_URL=postgres://user:password@localhost:5432/marketplace?sslmode=disable

# Maximum database connections in the pool (default: 200)
# DATABASE_MAX_CONNECTIONS=200

# -----------------------------------------------------------------------------
# Server Binding
# -----------------------------------------------------------------------------
# Host and port to bind the HTTP server (default: 127.0.0.1:3000)
# MARKETPLACE_BIND=127.0.0.1:3000

# -----------------------------------------------------------------------------
# Runtime Configuration
# -----------------------------------------------------------------------------
# Number of Tokio worker threads for async operations.
# Set to match your CPU cores for optimal performance.
# Default: CPU count - 1 (capped at 8)
# Example: 16 cores -> 8 workers
# TOKIO_WORKER_THREADS=8

# Number of Actix-web workers for handling HTTP requests.
# Default: CPU count * 4 (clamped between 16 and 64)
# Higher values help with high concurrency workloads.
# ACTIX_WORKERS=32

# -----------------------------------------------------------------------------
# Caching
# -----------------------------------------------------------------------------
# Enable/disable in-memory caching (default: enabled)
# Set to "1" or "true" to disable: MARKETPLACE_DISABLE_CACHE=1
# MARKETPLACE_DISABLE_CACHE=

# Listing cache maximum size in MB (default: 2048 = 2GB)
# Estimated ~3KB per cached listing entry
# LISTING_CACHE_MAX_MB=2048

# Search cache maximum size in MB (default: 1024 = 1GB)
# Estimated ~15KB per cached search result
# SEARCH_CACHE_MAX_MB=1024

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# RUST_LOG level: error, warn, info, debug, trace (default: info)
# RUST_LOG=info

# -----------------------------------------------------------------------------
# Benchmarking (binaries only)
# -----------------------------------------------------------------------------
# For populate_db: POPULATE_DB_SELLER_COUNT=1000
# For bench_concurrent: HTTP_BENCH_OPS=1000, HTTP_BENCH_CONCURRENCIES=100,500,1000