# =============================================================================
# Marketplace Server Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#
# Required for production:
#   - DATABASE_URL (server refuses to start if unset in production)
#
# Everything else has a working default; uncomment to override.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string (REQUIRED for production runtime).
# The server refuses to start if this is unset; see docs/deploy.md for the
# full DSN format and TLS options.
# DATABASE_URL=postgres://user:password@localhost:5432/marketplace?sslmode=disable

# Maximum database connections in the pool (default: 200)
# DATABASE_MAX_CONNECTIONS=200

# -----------------------------------------------------------------------------
# Server Binding
# -----------------------------------------------------------------------------
# Host and port to bind the HTTP server (default: 127.0.0.1:3000)
# MARKETPLACE_BIND=127.0.0.1:3000

# -----------------------------------------------------------------------------
# Runtime Configuration
# -----------------------------------------------------------------------------
# Number of Tokio worker threads for async operations.
# Set to match your CPU cores for optimal performance.
# Default: CPU count - 1 (capped at 8)
# Example: 16 cores -> 8 workers
# TOKIO_WORKER_THREADS=8

# Number of Actix-web workers for handling HTTP requests.
# Default: CPU count * 4 (clamped between 16 and 64)
# Higher values help with high concurrency workloads.
# ACTIX_WORKERS=32

# Graceful shutdown timeout in seconds (default: 30)
# SHUTDOWN_TIMEOUT_SECS=30

# -----------------------------------------------------------------------------
# Caching
# -----------------------------------------------------------------------------
# In-memory listing/search cache toggle (default: enabled).
# Reads the env var at startup. Set to "1" or "true" to keep the cache
# enabled; any other value (e.g. "0", "false", "no") disables it.
# MARKETPLACE_CACHE_ENABLED=true

# Listing cache maximum size in MB (default: 200)
# Estimated ~3KB per cached listing entry
# LISTING_CACHE_MAX_MB=200

# Search cache maximum size in MB (default: 100)
# Estimated ~15KB per cached search result
# SEARCH_CACHE_MAX_MB=100

# Credit ledger cache TTL in seconds (default: 300; security-relevant)
# LEDGER_CACHE_TTL_SECS=300

# Write-ahead log directory for crash recovery of credit ledger
# (default: ./data/ledger.wal)
# LEDGER_WAL_PATH=./data/ledger.wal

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# RUST_LOG level: error, warn, info, debug, trace (default: info)
# RUST_LOG=info

# Log format: "text" (default) or "json" for structured logging (production)
# LOG_FORMAT=json

# Demo API key for zero-config agent auth via x-marketplace-api-key header.
# Maps to full-access Claims (seller + buyer + admin). Set to anything, e.g.:
# MARKETPLACE_API_KEY=demo-secret-key

# -----------------------------------------------------------------------------
# Benchmarking (binaries only)
# -----------------------------------------------------------------------------
# populate_db: how many synthetic sellers to create
# POPULATE_NUM_SELLERS=1000

# populate_db: how many listings per seller
# POPULATE_LISTINGS_PER_SELLER=100

# populate_db: how many reviews per listing
# POPULATE_REVIEWS_PER_LISTING=1

# bench_concurrent: total operations and concurrency fan-out
# HTTP_BENCH_OPS=1000
# HTTP_BENCH_CONCURRENCIES=100,500,1000
# HTTP_BENCH_CONCURRENCY=100  # singular alias of HTTP_BENCH_CONCURRENCIES

# bench_concurrent: claims-mode for synthetic auth (rotating|fixed|none)
# HTTP_BENCH_CLAIMS_MODE=rotating
# MARKETPLACE_BENCH_CLAIMS_JSON=  # JSON string for fixed mode

# phase5_bench: total operations for Phase 5 stress bench
# PHASE5_BENCH_OPS=10000
